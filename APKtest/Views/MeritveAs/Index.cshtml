@model IEnumerable<APKtest.Models.MeritveA>

@{
    ViewData["Title"] = "Index";
}

<h1>Meritve</h1>
<link rel="stylesheet" href="~/css/custom-style.css" />
<p>
    <a asp-action="Create" class="create-button">Create New</a>
</p>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Datum_Meritve)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Temperatura)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Vlažnost)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Okvara)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Merilna_Naprava.Ime)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Metrolog.Ime)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Datum_Meritve)</td>
                    <td>@Html.DisplayFor(modelItem => item.Temperatura)</td>
                    <td>@Html.DisplayFor(modelItem => item.Vlažnost)</td>
                    <td>@Html.DisplayFor(modelItem => item.Okvara)</td>
                    <td>@Html.DisplayFor(modelItem => item.Merilna_Naprava.Ime)</td>
                    <td>@Html.DisplayFor(modelItem => item.Metrolog.Ime)</td>
                    <td class="action-links">
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
