@model IEnumerable<APKtest.Models.MeritveA>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Datum_Meritve)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Temperatura)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Vlažnost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Okvara)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Merilna_Naprava)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Metrolog)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Datum_Meritve)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Temperatura)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Vlažnost)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Okvara)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Merilna_Naprava.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Metrolog.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
