@model IEnumerable<APKtest.Models.Metrolog>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
<link rel="stylesheet" href="~/css/custom-style.css" />


<p>
    <a asp-action="Create" class="create-button">Create New</a>
</p>

<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Ime)</th>
                <th>@Html.DisplayNameFor(model => model.Priimek)</th>
                <th>@Html.DisplayNameFor(model => model.Datum_Zaposlitve)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Ime)</td>
                    <td>@Html.DisplayFor(modelItem => item.Priimek)</td>
                    <td>@Html.DisplayFor(modelItem => item.Datum_Zaposlitve)</td>
                    <td class="action-links">
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
